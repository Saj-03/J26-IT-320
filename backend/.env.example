APP_NAME=IHUSD Backend
# Neon: copy the pooled connection string from the Neon console
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# For quick local demo without Postgres, use:
# DATABASE_URL=sqlite:///./ihusd.sqlite3
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
LLM_API_KEY=
# Pilot: research_ids whose chat gets NO academic context (Baseline 2), comma-separated, e.g. P-1a2b3c4d,P-5e6f7a8b
BASELINE2_IDS=
TIP_POLICY=rules
BANDIT_IDS=
LLM_MODEL=claude-sonnet-4-6
# Optional: use any OpenAI-compatible provider instead of Anthropic (e.g. a free Groq key):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
RISK_SIGNAL_MAX_AGE_HOURS=24
URGENT_DEADLINE_WINDOW_HOURS=48
