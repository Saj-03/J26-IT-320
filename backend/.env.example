APP_NAME=IHUSD Backend
# Neon: copy the pooled connection string from the Neon console
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# For quick local demo without Postgres, use:
# DATABASE_URL=sqlite:///./ihusd.sqlite3
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
RISK_SIGNAL_MAX_AGE_HOURS=24
URGENT_DEADLINE_WINDOW_HOURS=48
